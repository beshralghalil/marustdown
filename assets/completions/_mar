#compdef mar

autoload -U is-at-least

_mar() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : \
'--color=[When to style printed output\: \`auto\` styles only when writing to a terminal]:WHEN:(auto always never)' \
'--width=[Maximum content width in columns]:N:_default' \
'--theme=[Color preset\: dark, light, ansi, or a theme file name]:NAME:_default' \
'--config=[Config file to use instead of \$XDG_CONFIG_HOME/marustdown/config.toml]:PATH:_files' \
'--cat[Print the rendered document and exit instead of paging (automatic when stdout isn'\''t a terminal)]' \
'--no-color[Same as \`--color never\` (NO_COLOR is honored too)]' \
'--no-icons[Use ASCII glyphs instead of icons]' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
'-V[Print version]' \
'--version[Print version]' \
'::file -- Markdown file to view; `-` or nothing reads stdin:_files' \
&& ret=0
}

(( $+functions[_mar_commands] )) ||
_mar_commands() {
    local commands; commands=()
    _describe -t commands 'mar commands' commands "$@"
}

if [ "$funcstack[1]" = "_mar" ]; then
    _mar "$@"
else
    compdef _mar mar
fi
